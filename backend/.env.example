# Application
APP_NAME=Plant Disease Detection System
APP_VERSION=1.0.0
DEBUG=False
API_V1_PREFIX=/api/v1

# CORS (comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB
MONGODB_URI=mongodb+srv://mouli:ganesh123@cluster0.sjmulmw.mongodb.net/plant_disease_db?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=plant_disease_db

# ML Model (paths are relative to the backend/ directory)
MODEL_PATH=ml_model/saved_model/plant_disease_model.keras
CLASS_NAMES_PATH=ml_model/saved_model/class_names.json
DISEASE_INFO_PATH=ml_model/saved_model/disease_info.json
IMAGE_SIZE=224
CONFIDENCE_THRESHOLD=40.0

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png

# Logging
LOG_LEVEL=INFO
